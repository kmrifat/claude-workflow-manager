<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Substituted from the APS_ENVIRONMENT build setting: `development` in Debug,
	  `production` in Release. One value per build — the entitlement cannot say
	  both — and getting it wrong is the classic "pushes accepted, nothing
	  arrives" afternoon, because the two environments issue different device
	  tokens and each rejects the other's.

	  Note that TestFlight is `production` despite feeling like testing, which is
	  why this follows the configuration rather than a decision anyone has to
	  remember at archive time.
	-->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
