<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  `CFBundleDisplayName` (Finder and the About box) is honored from this file.
	  `CFBundleName` — what the macOS app menu, the bold first menu, uses — is NOT:
	  GENERATE_INFOPLIST_FILE derives it from PRODUCT_NAME and overrides any value
	  here, so the app menu name is set by PRODUCT_NAME = "Claude WM" in the target
	  build settings, not by a key in this file.
	-->
	<key>CFBundleDisplayName</key>
	<string>Claude WM</string>

	<!--
	  Declares the drag payload type used by the Kanban board. Without this,
	  UTType(exportedAs:) in Transfer/WorkItemTransfer.swift refers to a type
	  the system has never heard of: the drag starts, but the drop side cannot
	  resolve the payload.

	  Everything else in the bundle's Info.plist is still generated by Xcode —
	  GENERATE_INFOPLIST_FILE stays YES and merges its keys into this file.

	  Lives at the repo root on purpose: workflow-manager/ is a
	  PBXFileSystemSynchronizedRootGroup, so a plist placed there would also be
	  copied into the app bundle as a stray resource.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.binarycastle.workflow-manager.workitem</string>
			<key>UTTypeDescription</key>
			<string>Claude WM Work Item</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
